{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "AppSecAI Manual Analysis",
          "version": "1.0.0",
          "informationUri": "https://appsecure.ai",
          "rules": [
            {
              "id": "AS-CWE-78",
              "name": "OsCommandInjection",
              "shortDescription": {
                "text": "OS Command Injection via subprocess shell=True"
              },
              "fullDescription": {
                "text": "User-controlled input is passed directly to subprocess.run() with shell=True, allowing attackers to execute arbitrary OS commands."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/78.html",
              "properties": {
                "tags": [
                  "security",
                  "correctness",
                  "OWASP-A03"
                ],
                "cwe": "CWE-78",
                "owasp": "A03:2021 \u2013 Injection"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "AS-CWE-798",
              "name": "HardcodedCredentials",
              "shortDescription": {
                "text": "Use of Hard-coded Credentials or Secrets"
              },
              "fullDescription": {
                "text": "AWS access keys, RSA private keys, AES keys, and admin API keys are hardcoded in source files. Exposure in version control or logs compromises all dependent systems."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/798.html",
              "properties": {
                "tags": [
                  "security",
                  "OWASP-A02"
                ],
                "cwe": "CWE-798",
                "owasp": "A02:2021 \u2013 Cryptographic Failures"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "AS-CWE-502",
              "name": "InsecureDeserialization",
              "shortDescription": {
                "text": "Deserialization of Untrusted Data via pickle.loads"
              },
              "fullDescription": {
                "text": "pickle.loads() is called on attacker-controlled bytes. Pickle deserialization can execute arbitrary Python code, providing full RCE to any attacker who can supply the serialized payload."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/502.html",
              "properties": {
                "tags": [
                  "security",
                  "correctness",
                  "OWASP-A08"
                ],
                "cwe": "CWE-502",
                "owasp": "A08:2021 \u2013 Software and Data Integrity Failures"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "AS-CWE-918",
              "name": "ServerSideRequestForgery",
              "shortDescription": {
                "text": "Server-Side Request Forgery (SSRF)"
              },
              "fullDescription": {
                "text": "The /utils/fetch_url endpoint accepts an arbitrary URL from the client and issues a server-side HTTP request with no host or scheme allowlist, enabling access to internal services and cloud metadata endpoints."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/918.html",
              "properties": {
                "tags": [
                  "security",
                  "OWASP-A10"
                ],
                "cwe": "CWE-918",
                "owasp": "A10:2021 \u2013 Server-Side Request Forgery"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "AS-CWE-601",
              "name": "OpenRedirect",
              "shortDescription": {
                "text": "Unvalidated URL Redirect (Open Redirect)"
              },
              "fullDescription": {
                "text": "The login endpoint accepts a redirect_url parameter and issues a 302 redirect to it without validating the destination host, enabling phishing attacks via trusted domain."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/601.html",
              "properties": {
                "tags": [
                  "security",
                  "OWASP-A01"
                ],
                "cwe": "CWE-601",
                "owasp": "A01:2021 \u2013 Broken Access Control"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "AS-CWE-89",
              "name": "SqlInjection",
              "shortDescription": {
                "text": "SQL Injection via user-controlled query string"
              },
              "fullDescription": {
                "text": "The premium_database_query endpoint passes the user's query string directly to cursor.execute(), allowing any authenticated 'premium' user to run arbitrary SQL against the anime database."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/89.html",
              "properties": {
                "tags": [
                  "security",
                  "correctness",
                  "OWASP-A03"
                ],
                "cwe": "CWE-89",
                "owasp": "A03:2021 \u2013 Injection"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "AS-CWE-287",
              "name": "BrokenAuthentication",
              "shortDescription": {
                "text": "Broken Authentication \u2014 substring match grants premium access"
              },
              "fullDescription": {
                "text": "Premium subscription check is implemented as 'premium' in token.lower(). Any token containing the substring 'premium' (e.g. 'notpremium', 'premium123') bypasses the paywall entirely."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/287.html",
              "properties": {
                "tags": [
                  "security",
                  "OWASP-A07"
                ],
                "cwe": "CWE-287",
                "owasp": "A07:2021 \u2013 Identification and Authentication Failures"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "AS-CWE-329",
              "name": "WeakCryptographyStaticIV",
              "shortDescription": {
                "text": "AES-CBC encryption with static/hardcoded IV"
              },
              "fullDescription": {
                "text": "The AES_IV constant is a hardcoded 16-byte value. Reusing the same IV across all AES-CBC encryptions makes ciphertext patterns detectable and enables chosen-plaintext attacks (CBC-IV reuse)."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/329.html",
              "properties": {
                "tags": [
                  "security",
                  "cryptography",
                  "OWASP-A02"
                ],
                "cwe": "CWE-329",
                "owasp": "A02:2021 \u2013 Cryptographic Failures"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "AS-CWE-22",
              "name": "PathTraversalIncompleteNeutralization",
              "shortDescription": {
                "text": "Incomplete path traversal neutralization"
              },
              "fullDescription": {
                "text": "sanitize_file_path() removes '../' and '..\\ ' with str.replace(), which is bypassable via '....//'.replace('../','') == '../'. An attacker can read arbitrary files outside the intended directory."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/22.html",
              "properties": {
                "tags": [
                  "security",
                  "OWASP-A01"
                ],
                "cwe": "CWE-22",
                "owasp": "A01:2021 \u2013 Broken Access Control"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "AS-CWE-942",
              "name": "CORSMisconfiguration",
              "shortDescription": {
                "text": "CORS wildcard origin with credentials allowed"
              },
              "fullDescription": {
                "text": "CORSMiddleware is configured with allow_origins=['*'] and allow_credentials=True simultaneously. Browsers reject this combination per the Fetch spec, but the intent exposes session cookies to any origin if origins were to be relaxed."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/942.html",
              "properties": {
                "tags": [
                  "security",
                  "CORS",
                  "OWASP-A05"
                ],
                "cwe": "CWE-942",
                "owasp": "A05:2021 \u2013 Security Misconfiguration"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "AS-CWE-1021",
              "name": "WeakContentSecurityPolicy",
              "shortDescription": {
                "text": "Content-Security-Policy allows unsafe-inline scripts"
              },
              "fullDescription": {
                "text": "The CSP header includes 'unsafe-inline' in script-src, defeating the primary XSS mitigation that CSP provides. Any reflected or stored XSS payload will execute despite the header being present."
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/1021.html",
              "properties": {
                "tags": [
                  "security",
                  "CSP",
                  "OWASP-A05"
                ],
                "cwe": "CWE-1021",
                "owasp": "A05:2021 \u2013 Security Misconfiguration"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ]
        }
      },
      "artifacts": [
